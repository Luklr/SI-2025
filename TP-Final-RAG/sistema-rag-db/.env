# IMPORTANTE: Configura tu OpenAI API Key aquí
OPENAI_API_KEY=

# Configuración de base de datos
DB_TYPE=sqlite
SQLITE_DB_PATH=./data/sistema_rag.db

# Configuración RAG
CHUNK_SIZE=512
CHUNK_OVERLAP=50
SIMILARITY_TOP_K=5
EMBEDDING_MODEL=text-embedding-ada-002
LLM_MODEL=gpt-3.5-turbo
TEMPERATURE=0.1
